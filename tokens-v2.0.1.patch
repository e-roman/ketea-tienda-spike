   --badge-discount-font-weight: var(--font-weight-bold);
   --badge-dietary-radius: var(--radius-sm);
-  --badge-dietary-font-size: var(--font-size-2xs);
+  --badge-dietary-font-size: var(--font-size-xs);
   --badge-counter-radius: var(--radius-full);
-  --badge-counter-font-size: var(--font-size-2xs);
+  --badge-counter-font-size: var(--font-size-xs);
   --card-product-radius: var(--radius-md);
   --card-product-gap: var(--space-3);
   --card-content-radius: var(--radius-xl);
